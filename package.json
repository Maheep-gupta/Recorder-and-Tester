{
  "name": "replayr",
  "version": "0.1.0",
  "private": true,
  "description": "Replayr — record a production bug once, replay it against localhost or any environment, and verify the fix.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "selftest": "node scripts/selftest.js",
    "test": "node tests/run-all.js",
    "test:unit": "node tests/unit.test.js",
    "test:dom": "node tests/fingerprint.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "playwright": "1.62.1"
  }
}
